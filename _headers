# Netlify headers
# Cache static media aggressively (filename is stable; bust via path if you re-upload)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# MP4 byte-range support is automatic on Netlify, but make sure it's explicit
/assets/opening.mp4
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: video/mp4
  Accept-Ranges: bytes

/assets/bgm.mp3
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: audio/mpeg
  Accept-Ranges: bytes

# JSX / JS modules — short cache while iterating
/*.jsx
  Cache-Control: public, max-age=300
/*.js
  Cache-Control: public, max-age=300
